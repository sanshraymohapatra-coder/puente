# .env — Puente
# Copy this file to .env and fill in your values.
# Never commit .env to GitHub — it contains secrets.

# ── Twilio ────────────────────────────────────────────────────────────────────
# Find these at console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your API key at console.anthropic.com
# Used only for category classification — one small call per free-text message.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Flask ─────────────────────────────────────────────────────────────────────
# Set to "development" locally, leave as "production" on Railway/Render
FLASK_ENV=production

# Port (Railway sets this automatically; leave as 5000 for local)
PORT=5000
